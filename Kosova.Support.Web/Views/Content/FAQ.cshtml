@model IEnumerable<FAQ>
<h1>Frequently asked questions</h1>
<div class="accordion" id="faqAcc">
@foreach (var item in Model)
{
    <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-@item.Id">@item.Question</button></h2>
        <div id="faq-@item.Id" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body">@item.Answer</div></div>
    </div>
}
</div>
