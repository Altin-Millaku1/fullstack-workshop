@model IEnumerable<Event>
<h1>Events</h1>
@foreach (var item in Model)
{
    <article class="mb-3 p-3 border rounded">
        <h2 class="h5">@item.Title</h2>
        <p>@item.Description</p>
        <p><strong>Date:</strong> @item.StartsAtUtc.ToLocalTime().ToString("f") | <strong>Location:</strong> @item.Location</p>
    </article>
}
