@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kosova.Support</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary" aria-label="Main navigation">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Kosova.Support</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">@Localizer["Services"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="OnlineApplications">Applications</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index">Payments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="Documents">Documents</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="News">@Localizer["News"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="Events">@Localizer["Events"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="FAQ">@Localizer["FAQ"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="Emergency">Emergency</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="Tenders">Tenders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="Contact">@Localizer["Contact"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Content" asp-action="SystemStatus">@Localizer["System Status"]</a></li>
                </ul>
                <form asp-controller="Content" asp-action="SetLanguage" method="post" class="d-flex me-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <label class="visually-hidden" for="langSel">Language</label>
                    <select id="langSel" name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="sq" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "sq")">Shqip</option>
                        <option value="en" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">English</option>
                        <option value="sr" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "sr")">Srpski</option>
                    </select>
                </form>
                <button type="button" class="btn btn-outline-light btn-sm me-2" id="themeToggle">🌙</button>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>
<main id="main-content" class="container py-4" tabindex="-1">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @RenderBody()
</main>
<footer class="border-top footer py-4 bg-light mt-5">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="d-flex flex-wrap gap-3 small">
                    <a asp-controller="Content" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Content" asp-action="Terms">Terms of Use</a>
                    <a asp-controller="Content" asp-action="Accessibility">Accessibility Statement</a>
                    <a asp-controller="Content" asp-action="HelpCenter">Help Center</a>
                </div>
                <p class="mb-1 mt-2">Contact: info@kosova.support | +383 38 000 000</p>
                <strong>Prototype / Demonstration Website</strong>
            </div>
            <div class="col-md-4 text-md-end small">
                <div>© @DateTime.UtcNow.Year Kosova.Support</div>
                <div>Not an official government portal.</div>
            </div>
        </div>
    </div>
</footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
