@model Service
@{ ViewData["Title"] = "Service details"; }
<h1>@Model.Title</h1>
<p>@Model.Description</p>
<ul>
    <li>Category: @Model.ServiceCategory?.Name</li>
    <li>Department: @Model.Department?.Name</li>
    <li>Fee: €@Model.Fee</li>
    <li>Estimated processing: @Model.EstimatedDays days</li>
</ul>
<a class="btn btn-primary" asp-controller="Applications" asp-action="Create">Apply online</a>
