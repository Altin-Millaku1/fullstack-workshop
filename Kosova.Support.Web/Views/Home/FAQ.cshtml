@model List<FAQ>
@{ ViewData["Title"] = "FAQ"; }
<h1>Frequently asked questions</h1>
<div class="accordion" id="faqAccordion">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading@i">
                <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@i" aria-expanded="@(i == 0)" aria-controls="collapse@i">@Model[i].Question</button>
            </h2>
            <div id="collapse@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#faqAccordion">
                <div class="accordion-body">@Model[i].Answer</div>
            </div>
        </div>
    }
</div>
