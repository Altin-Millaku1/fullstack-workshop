@model Service
@{
    ViewData["Title"] = Model.Name;
}
<h1>@Model.Name</h1>
<p>@Model.Summary</p>
<dl class="row">
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department?.Name</dd>
    <dt class="col-sm-3">Eligibility</dt><dd class="col-sm-9">@Model.Eligibility</dd>
    <dt class="col-sm-3">Required documents</dt><dd class="col-sm-9">@Model.RequiredDocuments</dd>
    <dt class="col-sm-3">Fee</dt><dd class="col-sm-9">@Model.FeeAmount.ToString("0.00") EUR</dd>
</dl>
@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Applications" asp-action="Start" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="serviceId" value="@Model.Id" />
        <button class="btn btn-primary">Start application</button>
    </form>
}
else
{
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Sign in to apply</a>
}
