@model List<Kosova.Support.Web.Data.ApplicationUser>
<h1>Manage users and roles</h1>
<table class="table table-striped"><thead><tr><th>Email</th><th>Name</th><th>Email confirmed</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Email</td><td>@u.FullName</td><td>@u.EmailConfirmed</td></tr>}</tbody></table>
