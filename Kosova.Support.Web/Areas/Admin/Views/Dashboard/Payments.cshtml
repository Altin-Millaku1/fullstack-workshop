@model List<Payment>
<h1>Manage payments and refunds</h1>
<table class="table table-striped"><thead><tr><th>Reference</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.ProviderReference</td><td>@p.Amount @p.Currency</td><td>@p.Status</td></tr>}</tbody></table>
