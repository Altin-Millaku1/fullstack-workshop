@model IEnumerable<Kosova.Support.Core.Entities.Application>
<h1>Manage applications</h1>
<table class="table"><thead><tr><th>Id</th><th>Service</th><th>Status</th><th>Step</th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.Id</td><td>@item.Service?.Name</td><td>@item.Status</td><td>@item.CurrentStep</td></tr>}</tbody></table>
